# ─── Database ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/prescription_db?schema=public"

# ─── JWT Authentication ───────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-this"

# ─── Server ───────────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL="http://localhost:5173"

# ─── Razorpay (Optional — for online payments) ───────────────────────
# RAZORPAY_KEY_ID="rzp_test_xxxxx"
# RAZORPAY_KEY_SECRET="your_razorpay_secret"
# RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# ─── AI Integration (Optional — for voice notes, patient summary) ────
# AI_API_KEY="your_openai_or_gemini_api_key"
# AI_PROVIDER="openai"  # or "gemini"

# ─── File Storage (Optional — for document uploads) ──────────────────
# AWS_S3_BUCKET="mednivo-uploads"
# AWS_ACCESS_KEY_ID="your_aws_key"
# AWS_SECRET_ACCESS_KEY="your_aws_secret"
# AWS_REGION="ap-south-1"

# ─── Email (Optional — for notifications) ────────────────────────────
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"

# ─── DrugSetu Medicine API ───────
DRUGSETU_API_KEY=""
